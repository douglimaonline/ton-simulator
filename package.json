{
  "name": "ton-simulator",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "predeploy": "if exist .\\docs rmdir /s /q .\\docs && ng build --configuration=production --output-path docs",
    "deploy": "if exist .\\docs\\browser robocopy .\\docs\\browser .\\docs /MOVE /E && if exist .\\docs\\browser rmdir /s /q .\\docs\\browser"
  },
  "private": true,
